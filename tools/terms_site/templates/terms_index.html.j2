{% extends "base.html.j2" %}
{#- The full dictionary. Filtering is client-side and progressive: without
    JavaScript every term is still listed and every row is still a link. -#}

{% block content %}
<div style="max-width:980px">
  <div class="eyebrow">Reference</div>
  <h1 class="page-title">Business Terms</h1>

  <div class="filter-bar" data-filter-bar>
    <button class="pill" type="button" data-filter="all" aria-pressed="true">All</button>
    {%- for area in areas %}
    <button class="pill" type="button" data-filter="area:{{ area.slug }}" aria-pressed="false">{{ area.pref_label }}</button>
    {%- endfor %}
    <button class="pill" type="button" data-filter="attention" aria-pressed="false">Needs attention</button>
    <span class="filter-bar__count" data-term-count>{{ terms | length }} term{{ "" if terms | length == 1 else "s" }}</span>
  </div>

  <div class="term-table">
    <div class="term-row term-row--head" aria-hidden="true">
      <div>Term</div><div>Subject area</div><div>Status</div><div>Steward</div><div></div>
    </div>
    {%- for term in terms %}
    <a class="term-row"
       href="{{ rel }}{{ term.url }}"
       data-area="{{ term.area.slug }}"
       data-status="{{ term.status }}"
       data-name="{{ term.pref_label | lower }}">
      <span class="term-row__name{% if term.status == 'deprecated' %} term-row__name--deprecated{% endif %}">{{ term.pref_label }}</span>
      <span class="term-row__sub">{{ term.area.pref_label }}</span>
      <span><span class="badge badge--{{ term.status }}">{{ term.status_label }}</span></span>
      <span class="term-row__sub">{{ term.steward.pref_label if term.steward else "—" }}</span>
      <span class="term-row__chev" aria-hidden="true">&rsaquo;</span>
    </a>
    {%- endfor %}
    <div class="empty-state" data-empty hidden>No terms match that filter.</div>
  </div>

  {#- Pagination is a progressive enhancement: every row is rendered above and
      is a real link, so with JavaScript off the whole dictionary is one page.
      The script reveals these controls and pages the list only when there are
      more terms than fit on a page. -#}
  <nav class="pager" data-pager aria-label="Term index pages" hidden>
    <div class="pager__size">
      <label for="page-size">Per page</label>
      <select id="page-size" data-page-size>
        <option value="10">10</option>
        <option value="25" selected>25</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
    </div>
    <div class="pager__nav" data-pager-nav hidden>
      <button class="pager__btn" type="button" data-pager-prev>&lsaquo; Previous</button>
      <span class="pager__status" data-pager-status aria-live="polite"></span>
      <button class="pager__btn" type="button" data-pager-next>Next &rsaquo;</button>
    </div>
  </nav>
</div>
{% endblock %}
