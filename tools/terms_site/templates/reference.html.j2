{% extends "base.html.j2" %}
{#- gen-doc output wrapped in the site shell so the technical reference does
    not look like a different website. The body is gen-doc's Markdown rendered
    to HTML, with its .md links rewritten to .html. -#}

{% block content %}
<div class="split">
  <article class="split__body split__body--wide">
    <div class="eyebrow">Schema reference</div>
    <h1 class="page-title">{{ page_title }}</h1>
    <p class="lede">Generated by <code>gen-doc</code> from <code>{{ schema_name }}</code>. This
    documents the shape of a term, not the terms themselves &mdash; for those, see the
    <a href="{{ rel }}terms/index.html">dictionary</a>.</p>
    <div class="prose">{{ body | safe }}</div>
  </article>

  {%- if siblings %}
  <aside class="split__aside">
    <div class="toc-rail">
      <div class="toc-rail__label">Schema reference</div>
      {%- for sibling in siblings %}
      <a href="{{ rel }}{{ sibling.url }}"{% if sibling.url == current_url %} class="is-active"{% endif %}>{{ sibling.label }}</a>
      {%- endfor %}
    </div>
  </aside>
  {%- endif %}
</div>
{% endblock %}

{% block scripts %}
{%- if has_diagram %}
{#- Mermaid is loaded only on reference pages that actually contain a diagram,
    and only from a CDN. If it is blocked on an internal network the <pre> keeps
    the diagram source visible rather than leaving an empty box. -#}
<script type="module">
  try {
    const mermaid = (await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs")).default;
    const dark = document.documentElement.getAttribute("data-theme") === "dark"
      || (!document.documentElement.getAttribute("data-theme")
          && window.matchMedia("(prefers-color-scheme: dark)").matches);
    // Not startOnLoad: this module resolves after the load event has already
    // fired, so mermaid has to be told to run.
    mermaid.initialize({ startOnLoad: false, theme: dark ? "dark" : "neutral" });
    await mermaid.run({ querySelector: "pre.mermaid" });
  } catch (e) {
    /* Offline or blocked: the diagram source stays readable in the <pre>. */
  }
</script>
{%- endif %}
{% endblock %}
