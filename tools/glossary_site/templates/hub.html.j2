{% extends "base.html.j2" %}
{#- Landing page. The hero and any prose come from docs/content/index.md;
    the counts, subject-area cards, recent changes and contacts are generated,
    so they cannot go stale relative to the glossary data. -#}

{% block content %}
<div class="hero">
  {%- if page.eyebrow %}<div class="eyebrow">{{ page.eyebrow }}</div>{% endif %}
  <h1 class="page-title page-title--hero">{{ page.title }}</h1>
  {%- if page.lede %}<p class="lede">{{ page.lede }}</p>{% endif %}
  <div class="button-row">
    <a class="btn btn--primary" href="{{ rel }}glossary.html">Browse the data dictionary</a>
    <a class="btn btn--secondary" href="{{ rel }}how-to-read-a-term.html">How to read a term</a>
  </div>
</div>

<div class="stat-grid">
  {%- for stat in stats %}
  <div class="stat">
    <div class="stat__n">{{ stat.n }}</div>
    <div class="stat__label">{{ stat.label }}</div>
  </div>
  {%- endfor %}
</div>

{%- if page.html %}
<div class="prose" style="margin-bottom:52px">{{ page.html | safe }}</div>
{%- endif %}

<h2 class="section-head">Start with your subject area</h2>
<div class="rule"></div>
<div class="area-grid">
  {%- for area in areas %}
  <a class="area-card" href="{{ rel }}{{ area.url }}">
    <div class="area-card__bar" style="background:{{ area.accent }}"></div>
    <div class="area-card__name">{{ area.pref_label }}</div>
    <p>{{ area.definition }}</p>
    <div class="area-card__meta">
      <span>{{ area.terms | length }} term{{ "" if area.terms | length == 1 else "s" }}</span>
      {%- if area.owner %}<span>{{ area.owner.pref_label }}</span>{% endif %}
    </div>
  </a>
  {%- endfor %}
</div>

<div class="two-col">
  <div>
    <h2 class="section-head">Recent changes</h2>
    <div class="rule"></div>
    {%- if recent_changes %}
    {%- for entry in recent_changes %}
    <div class="timeline-row">
      <div class="timeline-row__date">{{ entry.change.date }}</div>
      <div>
        <a class="timeline-row__title" href="{{ rel }}{{ entry.term.url }}">{{ entry.change.summary }}</a>
        <div class="timeline-row__meta">
          <span class="badge badge--{{ entry.term.status }}">{{ entry.term.status_label }}</span>
          <span>{{ entry.term.pref_label }} &middot; {{ entry.term.area.pref_label }}</span>
        </div>
      </div>
    </div>
    {%- endfor %}
    {%- else %}
    <p class="history__empty">No history available. This build has no git history to read
    — CI checks out with full depth, so the deployed site will show changes here.</p>
    {%- endif %}
  </div>

  <div>
    <h2 class="section-head">Who to contact</h2>
    <div class="rule"></div>
    {%- for contact in contacts %}
    <div class="contact">
      <div class="avatar" style="background:{{ contact.colour }}" aria-hidden="true">{{ contact.agent.initials }}</div>
      <div style="min-width:0">
        <div class="contact__name"><a href="{{ contact.agent.url }}">{{ contact.agent.pref_label }}</a></div>
        <div class="contact__role">{{ contact.roles | join(", ") }}</div>
        {%- if contact.agent.email %}
        <a href="mailto:{{ contact.agent.email }}">{{ contact.agent.email }}</a>
        {%- endif %}
      </div>
    </div>
    {%- endfor %}
  </div>
</div>
{% endblock %}
